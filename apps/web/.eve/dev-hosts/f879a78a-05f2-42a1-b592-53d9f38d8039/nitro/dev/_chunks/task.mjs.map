import { H3Core } from "h3";
import errorHandler from "#nitro/virtual/error-handler";
import { HookableCore } from "#nitro/runtime/hookable";
import { plugins } from "#nitro/virtual/plugins";
import { initAsyncPlugins } from "#nitro/runtime/async-plugins";
import { findRoute, globalMiddleware } from "#nitro/virtual/routing";
import { createMethodNotAllowedMatcher } from "#nitro/runtime/app";

export function createNitroApp() {
  const hooks = new HookableCore();

const captureError = (error, errorCtx) => {
    const promise = hooks.callHook("error", error, errorCtx)?.catch?.((hookError) => {
      console.error("Error while capturing another error", hookError);
    });
    if (errorCtx?.event) {
      const errors = errorCtx.event.req.context?.nitro?.errors;
      if (errors) {
        errors.push({ error, context: errorCtx });
      }
      if (promise && typeof errorCtx.event.req.waitUntil === "function") {
        errorCtx.event.req.waitUntil(promise);
      }
    }
  };

  const h3App = createH3App({
    onError(error, event) {
      captureError(error, { event });
      return errorHandler(error, event);
    },
  });

  h3App.config.onRequest = (event) => {
    return hooks.callHook("request", event)?.catch?.((error) => {
      captureError(error, { event, tags: ["request"] });
    });
  };
  h3App.config.onResponse = (res, event) => {
    return hooks.callHook("response", res, event)?.catch?.((error) => {
      captureError(error, { event, tags: ["response"] });
    });
  };

  let appHandler = (req) => {
    req.context ||= {};
    req.context.nitro = req.context.nitro || { errors: [] };
    return h3App.fetch(req);
  };

  return {
    fetch: appHandler,
    h3: h3App,
    hooks: hooks,
    captureError,
  };
}

export function initNitroPlugins(app) {
  for (let i = 0; i < plugins.length; i++) {
    let result;
    try {
      result = plugins[i](app);
    } catch (error) {
      app.captureError?.(error, { tags: ["plugin"] });
      throw error;
    }
    if (typeof result?.then === "function") {
      return initAsyncPlugins(app, result, plugins.slice(i + 1));
    }
  }
  app.h3["~dispatch"] = app.h3["~composed"] = undefined;
  return app;
}

function createH3App(config) {
  const h3App = new H3Core(config);
  h3App["~findRoute"] = (event) => {
    if (event.req.method === "HEAD") {
      const route = findRoute("HEAD", event.url.pathname);
      return route?.data.method ? route : findRoute("GET", event.url.pathname);
    }
    return findRoute(event.req.method, event.url.pathname) ?? findMethodNotAllowed(event.req.method, event.url.pathname);
  };
  const findMethodNotAllowed = createMethodNotAllowedMatcher(findRoute, ["DELETE","GET","HEAD","PATCH","POST","PUT"]);
  h3App["~middleware"].push(...globalMiddleware);
  return h3App;
}