# Supabase (Postgres + pgvector + Auth + Storage + Realtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"
NEXT_PUBLIC_SITE_URL="https://tariffos.app"
# Pin root "/" landing to a specific country during pilot rollout ("ve" | "global"); automatically hides the country switcher unless overridden
# NEXT_PUBLIC_DEFAULT_LANDING_COUNTRY="ve"
# NEXT_PUBLIC_SHOW_COUNTRY_SWITCHER="false"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Set to "true" only after enabling Google provider in Supabase Auth with valid OAuth credentials
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="true"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI & Decision Engine
TYPESAFE_API_KEY="your-typesafe-api-key"
DECISION_PROVIDER="typesafe"

# LLM provider for the classification pipeline: nvidia | google | openrouter | openai-compatible
LLM_PROVIDER="nvidia"
NVIDIA_API_KEY="nvapi-your-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"
# Optional: override the provider's default endpoint
# LLM_BASE_URL=""

# Tier 2 RGI reasoning models (model ids are provider-specific; switch provider + these to move to Gemini)
RGI_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
RGI_DEEP_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# Embeddings: must stay at 768 dims (TariffNodeEmbedding is vector(768))
EMBEDDING_MODEL="nvidia/nemotron-3.5-embed-1b"
EMBEDDING_DIMS="768"

# Classification Pipeline Controls
MAX_WEB_GROUNDING_STANDARD="12"

# Eve agent runtime (sole durable chat runtime — see docs/EVE_RUNTIME.md)
# Run together with `pnpm dev:all` (vercel dev --local, same-origin /eve/v1/*)
# or in two terminals: `pnpm dev:eve` (127.0.0.1:2000) + `pnpm dev` (localhost:3003, auto-proxies /eve/*)
EVE_MODEL="openrouter:nvidia/nemotron-3.5-super-vl"
NEXT_PUBLIC_AGENT_RUNTIME="eve"
# Optional: override Eve base URL (empty uses same-origin /eve/v1/* via vercel.ts or next.config.ts dev proxy)
# NEXT_PUBLIC_EVE_URL=""
# Optional: target Eve server URL for Next.js local dev proxy when running `pnpm dev` + `pnpm dev:eve`
# EVE_BASE_URL="http://127.0.0.1:2000"

# Web Search (Vercel Parallel Fast via AI Gateway)
# WEB_SEARCH_PROVIDER="parallel"   # parallel | serper | context
# WEB_SEARCH_PARALLEL_MODEL="google/gemini-2.5-flash-lite"

# Batch processing mode (defaults to inline in local dev so no Inngest CLI is required)
# BATCH_EXECUTION_MODE="auto"      # auto | inline | inngest

# Platform Admin Console (/admin)
# Comma-separated emails automatically elevated to super_admin on first login
PLATFORM_ADMIN_EMAILS=""
# Transactional Email for Super Admin temporary credential delivery (Resend or Cloudflare Email Sending)
# RESEND_API_KEY="re_your_key"
# EMAIL_FROM="TariffOS <acceso@tariffos.app>"
# Or Cloudflare Email Sending fallback:
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# EMAIL_FROM_ADDRESS="acceso@tariffos.app"
# Optional webhook URL notified when a new lead is captured via POST /api/leads
# LEADS_WEBHOOK_URL=""
# Optional webhook URL notified when a client submits a manual payment in /activate-plan (falls back to LEADS_WEBHOOK_URL)
# BILLING_WEBHOOK_URL=""
# Optional WhatsApp commercial contact (digits only, e.g. 584125550199) and payment coordinates shown in /activate-plan
# NEXT_PUBLIC_SUPPORT_WHATSAPP=""
# NEXT_PUBLIC_PAYMENT_ZELLE_INFO=""
# NEXT_PUBLIC_PAYMENT_BINANCE_INFO=""
# NEXT_PUBLIC_PAYMENT_PAGO_MOVIL_INFO=""
# NEXT_PUBLIC_PAYMENT_TRANSFER_USD_INFO=""
# NEXT_PUBLIC_PAYMENT_TRANSFER_BS_INFO=""
# Optional fallback mirror for BCV official USD/EUR rates when bcv.org.ve is unreachable
# BCV_FALLBACK_BASE_URL="https://ve.dolarapi.com/v1"

# Feature Flags (Vercel Flags SDK — optional; falls back to env defaults when unset)
# Auto-provisioned by Vercel when creating flags; pull via `vercel env pull .env.local`
# FLAGS_SECRET=""
# Optional SDK key when running outside Vercel without VERCEL_OIDC_TOKEN
# FLAGS=""
