# Supabase (Postgres + pgvector + Auth + Storage + Realtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI & Decision Engine
TYPESAFE_API_KEY="your-typesafe-api-key"
DECISION_PROVIDER="typesafe"

# LLM provider for the classification pipeline: nvidia | google | openrouter | openai-compatible
LLM_PROVIDER="nvidia"
NVIDIA_API_KEY="nvapi-your-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"
# Optional: override the provider's default endpoint
# LLM_BASE_URL=""

# Tier 2 RGI reasoning models (model ids are provider-specific; switch provider + these to move to Gemini)
RGI_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
RGI_DEEP_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# Embeddings: must stay at 768 dims (TariffNodeEmbedding is vector(768))
EMBEDDING_MODEL="nvidia/nemotron-3.5-embed-1b"
EMBEDDING_DIMS="768"

# Classification Pipeline Controls
MAX_WEB_GROUNDING_STANDARD="12"

# Eve agent model (supports anthropic:, openai:, openrouter:, nvidia:, or gateway provider/model)
EVE_MODEL="openrouter:nvidia/nemotron-3.5-super-vl-120b-a12b"

# Platform Admin Console (/admin)
# Comma-separated emails automatically elevated to super_admin on first login
PLATFORM_ADMIN_EMAILS=""
# Optional webhook URL notified when a new lead is captured via POST /api/leads
# LEADS_WEBHOOK_URL=""
# Optional fallback mirror for BCV official USD/EUR rates when bcv.org.ve is unreachable
# BCV_FALLBACK_BASE_URL="https://ve.dolarapi.com/v1"
