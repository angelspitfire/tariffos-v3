{
  "name": "tariffos-v3",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:eve": "eve dev",
    "dev:all": "vercel dev --local",
    "dev:inngest": "npx -y inngest-cli@latest dev -u http://localhost:3003/api/inngest",
    "bootstrap": "pnpm --filter @tariffos/database... build",
    "build:packages": "pnpm bootstrap && pnpm -r --filter '@tariffos/*' --filter '!@tariffos/database' build",
    "build": "pnpm bootstrap && pnpm -r --filter=!@tariffos/database build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint apps packages",
    "test": "pnpm -r --if-present test",
    "check": "node scripts/check.mjs",
    "check:quick": "node scripts/check.mjs --quick",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:db": "node scripts/check-db-live.mjs",
    "check:db:static": "node scripts/check-db-static.mjs --schema",
    "smoke:llm": "node scripts/smoke-llm.mjs",
    "llm:models": "node scripts/llm-models.mjs",
    "admin:users": "pnpm --filter @tariffos/database exec tsx src/scripts/platform-admin.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.118",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.90.0",
    "@tariffos/agent": "workspace:*",
    "@tariffos/database": "workspace:*",
    "@tariffos/shared-types": "workspace:*",
    "eve": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
