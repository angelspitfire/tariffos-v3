{
  "name": "@tariffos/ai-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical LLM provider port for TariffOS, on Vercel AI SDK.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.91",
    "@tariffos/env": "workspace:^",
    "ai": "^7.0.171",
    "jsonrepair": "^3.15.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "license": "ISC"
}
